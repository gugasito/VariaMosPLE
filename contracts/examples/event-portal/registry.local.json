{
  "schemaVersion": "spl-resource-registry/v1",
  "catalogs": {
    "event-portal.catalog.static": "catalogs/static.local.json",
    "event-portal.catalog.monolith": "catalogs/monolith.local.json"
  },
  "targets": {
    "event-portal.target.static.local": { "path": "targets/static.local.json", "port": 8089, "releaseState": "static" },
    "event-portal.target.monolith.local": { "path": "targets/monolith.local.json", "port": 8091, "releaseState": "monolith", "dataState": "data" }
  },
  "profiles": {
    "event-portal.static.local": {
      "name": "Event Portal — static site",
      "mappingRef": "mapping.event-portal.static.v1",
