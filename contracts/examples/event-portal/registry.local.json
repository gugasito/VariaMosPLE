      "targetRef": "event-portal.target.static.local"
    },
    "event-portal.monolith.local": {
      "name": "Event Portal — modular monolith",
      "mappingRef": "mapping.event-portal.monolith.v1",
      "catalogRef": "event-portal.catalog.monolith",
      "targetRef": "event-portal.target.monolith.local"
    }
  },
  "localRoots": {
    "event-portal-assets": "../../../examples/event-portal/artifacts"
  }
