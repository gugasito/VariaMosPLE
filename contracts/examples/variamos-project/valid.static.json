{
  "schemaVersion": "variamos-project/v1",
  "status": "ready",
  "project": {
    "id": "external-event-portal",
    "name": "External Event Portal",
    "description": "Independent Git project that exposes static artifacts to VariaMos."
  },
  "artifacts": [
    {
      "id": "external-event-portal.shell",
      "label": "Portal shell",
      "kind": "html-fragment",
      "version": "1.0.0",
      "source": { "path": "artifacts/shell.html" },
      "requiresCapabilities": ["static-http"]
    },
    {
      "id": "external-event-portal.agenda",
      "label": "Agenda",
      "kind": "html-fragment",
      "version": "1.0.0",
      "source": { "path": "artifacts/agenda.html" },
      "requiresCapabilities": ["static-http"]
    },
    {
      "id": "external-event-portal.registration.ui",
      "label": "Registration form",
      "kind": "html-fragment",
      "version": "1.0.0",
      "source": { "path": "artifacts/registration-form.html" },
      "requiresCapabilities": ["static-http"]
    },
    {
      "id": "external-event-portal.registration.confirmation",
      "label": "Registration confirmation",
      "kind": "html-fragment",
      "version": "1.0.0",
      "source": { "path": "artifacts/registration-confirmation.html" },
      "requiresCapabilities": ["static-http"]
    }
  ],
  "profiles": [
    {
      "id": "external-event-portal.static",
      "name": "External static site",
      "builderAdapter": "static-site-v1",
      "testAdapter": "html-validation-v1",
      "artifactIds": [
        "external-event-portal.shell",
        "external-event-portal.agenda",
        "external-event-portal.registration.ui",
        "external-event-portal.registration.confirmation"
      ],
      "requiredTargetCapabilities": ["docker", "static-http"]
    }
  ]
}
