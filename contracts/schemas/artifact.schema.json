{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variamosple.org/schemas/spl/artifact/v1",
  "title": "SPL software artifact",
  "description": "A versioned technical asset that can participate in a derived product.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "version",
    "source",
    "integrity",
    "build",
    "requiresCapabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "artifact/v1"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "kind": {
      "enum": [
        "html-fragment",
        "source-bundle",
        "module",
        "configuration",
        "template",
        "test-suite",
        "container-image"
      ]
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "location"],
      "properties": {
        "provider": {
          "enum": ["git", "http", "local", "oci", "artifact-registry"]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*\\.\\./).+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provider": { "const": "git" } },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "ref": true,
              "path": true
            },
            "required": ["ref", "path"]
          }
        },
        {
          "if": {
            "properties": { "provider": { "const": "local" } },
            "required": ["provider"]
          },
          "then": {
            "properties": {
              "path": true
            },
            "required": ["path"]
          }
        }
      ]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {
          "$ref": "#/$defs/stableId"
        },
        "entrypoint": {
          "type": ["string", "null"],
          "maxLength": 1024
        }
      }
    },
    "dependsOn": {
      "type": "array",
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    },
    "requiresCapabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stableId" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 120
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
