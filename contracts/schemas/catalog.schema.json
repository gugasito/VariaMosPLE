{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variamosple.org/schemas/spl/catalog/v1",
  "title": "SPL artifact catalog",
  "description": "A versioned inventory of artifacts available for one software-product-line domain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "derivation", "artifacts"],
  "properties": {
    "schemaVersion": {
      "const": "artifact-catalog/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builderAdapter"],
      "properties": {
        "builderAdapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 120
        },
        "testAdapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 120
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://variamosple.org/schemas/spl/artifact/v1"
      }
    }
  }
}
