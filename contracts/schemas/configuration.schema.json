{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://variamosple.org/schemas/dspl/configuration/v1",
  "title": "DSPL product configuration",
  "description": "A feature selection produced from one version of a VariaMos model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "productLineId", "modelVersion", "selections"],
  "properties": {
    "schemaVersion": {
      "const": "product-configuration/v1"
    },
    "id": {
      "$ref": "#/$defs/stableId"
    },
    "productLineId": {
      "$ref": "#/$defs/stableId"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "selected"],
        "properties": {
          "featureId": {
            "$ref": "#/$defs/stableId"
          },
          "selected": {
            "type": "boolean"
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 120
    }
  }
}
