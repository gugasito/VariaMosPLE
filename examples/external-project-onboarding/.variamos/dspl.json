{
  "schemaVersion": "variamos-project/v1",
  "status": "ready",
  "project": {
    "id": "external-event-portal",
    "name": "Portal de Eventos externo",
    "description": "Aplicación independiente preparada para incorporarse mediante el contrato de VariaMos."
  },
  "artifacts": [
    { "id": "external-event-portal.shell", "label": "Estructura", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/shell.html" }, "requiresCapabilities": ["static-http"] },
    { "id": "external-event-portal.agenda", "label": "Agenda", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/agenda.html" }, "requiresCapabilities": ["static-http"] },
    { "id": "external-event-portal.registration.ui", "label": "Formulario de inscripción", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/registration-form.html" }, "requiresCapabilities": ["static-http"] },
    { "id": "external-event-portal.registration.confirmation", "label": "Confirmación de inscripción", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/registration-confirmation.html" }, "requiresCapabilities": ["static-http"] },
    { "id": "external-event-portal.notifications", "label": "Notificaciones", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/notifications.html" }, "requiresCapabilities": ["static-http"] },
    { "id": "external-event-portal.presential", "label": "Modalidad presencial", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/presential.html" }, "requiresCapabilities": ["static-http"] },
    { "id": "external-event-portal.venue-map", "label": "Mapa", "kind": "html-fragment", "version": "1.0.0", "source": { "path": "artifacts/venue-map.html" }, "requiresCapabilities": ["static-http"] }
  ],
  "profiles": [
    {
      "id": "external-event-portal.static",
      "name": "Sitio estático externo",
      "builderAdapter": "static-site-v1",
      "testAdapter": "html-validation-v1",
      "artifactIds": ["external-event-portal.shell", "external-event-portal.agenda", "external-event-portal.registration.ui", "external-event-portal.registration.confirmation", "external-event-portal.notifications", "external-event-portal.presential", "external-event-portal.venue-map"],
      "requiredTargetCapabilities": ["docker", "static-http"]
    }
  ]
}
