# Public frontend configuration. `npm start` works without copying this file:
# these values document the defaults and allow another environment to be used.
REACT_APP_NODE_ENV=development
REACT_APP_HOST=localhost
REACT_APP_PORT=3000

# Standard VariaMos gateway and services. They contain no secrets.
VARIAMOS_PUBLIC_GATEWAY=https://app.variamos.com
REACT_APP_VARIAMOS_ADMIN_API_URL=https://app.variamos.com/variamos_ms_admin
REACT_APP_VARIAMOS_LOGIN_URL=https://app.variamos.com/variamos_admin/#/login
REACT_APP_URLBACKENDLANGUAGE=https://app.variamos.com/variamos_ms_languages
REACT_APP_URLVMSPROJECTS=https://app.variamos.com/vms_projects

# Supporting services.
REACT_APP_URLBACKENDRESTRICTION=https://variamos-ms-restrictions2024.azurewebsites.net
REACT_APP_URLVARIAMOSLANGUAGES=https://app.variamos.com/variamos_languages
REACT_APP_URLVARIAMOSDOCUMENTATION=https://www.variamos.com
REACT_APP_URLVARIAMOSLANGDOCUMENTATION=https://www.variamos.com
REACT_APP_WEBSOCKET_URL=ws://127.0.0.1:1234

# SPL runs inside the VariaMos backend and persists only under this root.
SPL_STATE_ROOT=.runtime/spl
SPL_RESOURCE_REGISTRY_PATH=
# Development-only fixture targets. Set false in production; production targets
# must be registered through the remote SSH target API.
SPL_LOCAL_TARGETS_ENABLED=true

# Folder uploads are selected by the user in the browser. The VariaMos backend
# stores only the descriptor and declared artifacts under SPL_STATE_ROOT.
SPL_FOLDER_UPLOAD_ENABLED=false
SPL_UPLOAD_TTL_HOURS=24
SPL_UPLOAD_MAX_BYTES=104857600
SPL_UPLOAD_MAX_FILES=500

# Secure remote deployment. It remains off until every required control below
# is configured. No AWS access key belongs in this file; use an IAM role and the
# AWS SDK default credential chain.
SPL_REMOTE_DEPLOYMENT_ENABLED=false
# Authentication cannot be disabled. Both URLs are derived from
# VARIAMOS_PUBLIC_GATEWAY and are called server-to-server with the Bearer token.
# SSH deployment targets always prompt the owner for a password on each
# attempt. Use aws only when private Git source connections need Secrets
# Manager. macos-keychain is restricted to private-Git laboratory tests and is
# unavailable in production.
SPL_SECRET_BACKEND=none
SPL_LOCAL_MAC_SSH_TEST_MODE=false
SPL_AWS_REGION=

# Exact hosts, *.domain suffixes, IPs, or IPv4 CIDRs. Private addresses require
# an explicit IP/CIDR rule even when their hostname is listed.
SPL_GIT_HOST_ALLOWLIST=github.com,gitlab.com,bitbucket.org
SPL_SSH_HOST_ALLOWLIST=
SPL_HEALTH_HOST_ALLOWLIST=

# Server-side state only. Files/directories use 0600/0700 where supported.
SPL_AUDIT_SINK=file
