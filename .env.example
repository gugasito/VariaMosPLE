# Public frontend configuration. `npm start` works without copying this file:
# these values document the defaults and allow another environment to be used.
REACT_APP_NODE_ENV=development
REACT_APP_HOST=localhost
REACT_APP_PORT=3000

# Standard VariaMos gateway and services. They contain no secrets.
REACT_APP_VARIAMOS_PUBLIC_GATEWAY=https://app.variamos.com
REACT_APP_VARIAMOS_ADMIN_API_URL=https://app.variamos.com/variamos_ms_admin
REACT_APP_VARIAMOS_LOGIN_URL=https://app.variamos.com/variamos_admin/#/login
REACT_APP_URLBACKENDLANGUAGE=https://app.variamos.com/variamos_ms_languages
REACT_APP_URLVMSPROJECTS=https://app.variamos.com/vms_projects

# Supporting services.
REACT_APP_URLBACKENDRESTRICTION=https://variamos-ms-restrictions2024.azurewebsites.net
REACT_APP_URLVARIAMOSLANGUAGES=https://app.variamos.com/variamos_languages
REACT_APP_URLVARIAMOSDOCUMENTATION=https://www.variamos.com
REACT_APP_URLVARIAMOSLANGDOCUMENTATION=https://www.variamos.com
REACT_APP_WEBSOCKET_URL=ws://127.0.0.1:1234

# Local SPL orchestrator. Docker is used by this process, never by the browser.
REACT_APP_SPL_ORCHESTRATOR_URL=http://127.0.0.1:8090
SPL_ORCHESTRATOR_PORT=8090
SPL_EXTERNAL_PROJECT_STATE=/tmp/variamos-spl-external-projects
SPL_RESOURCE_REGISTRY_PATH=

# Normally keep this false. Enable it deliberately only to connect a local Git
# path during a laboratory session or an E2E test.
SPL_ALLOW_LOCAL_GIT_REPOSITORIES=false

# Explicitly authorizes local folders without Git. The orchestrator creates an
# immutable copy of declared artifacts before importing them.
SPL_ALLOW_LOCAL_DIRECTORIES=false
